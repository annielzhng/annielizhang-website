---
import "../styles/global.css";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.description, image = "/images/annie-li-zhang.jpg" } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · Science Communication`;
const path = Astro.url.pathname;
const nav = [
  { href: "/briefs/", label: "CSSC Briefs" },
  { href: "/research/", label: "Research" },
  { href: "/teaching/", label: "Teaching" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const canonical = new URL(path, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="CSSC Briefs" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=IBM+Plex+Mono:wght@400;500&family=Literata:ital,opsz,wght@0,7..72,400..650;1,7..72,400&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-inner">
        <a class="wordmark" href="/">{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot-inner">
        <p class="foot-id"><span class="foot-name">{site.name}</span><span class="foot-sep" aria-hidden="true">·</span><span>{site.title}, {site.affiliation}</span></p>
        <div class="foot-links">
          <a href={site.links.scholar}>Google Scholar</a>
          <a href={site.links.linkedin}>LinkedIn</a>
          <a href={site.links.x}>X</a>
          <a href={site.cv}>CV</a>
        </div>
      </div>
    </footer>
  </body>
</html>
