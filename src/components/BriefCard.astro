---
import { authorsLine, formatDate, type Brief } from "../lib/briefs";
import OpenAccess from "./OpenAccess.astro";
interface Props { brief: Brief; }
const { brief } = Astro.props;
const b = brief.data;
const href = `/briefs/${brief.id}/`;
// Cards show four tags at most: the method(s), then as many research areas as fit.
const shownAreas = b.areas.slice(0, Math.max(0, 4 - b.method.length));
---
<article class="brief" data-method={b.method.join("|")} data-areas={b.areas.join("|")}>
  <div class="brief-meta">
    <span class="brief-date">{formatDate(b.date)}</span>
    <span class="brief-journal">{b.journal}</span>
    {b.openAccess && <OpenAccess />}
    <p class="brief-authors"><span class="k">Authors</span><Fragment set:html={authorsLine(b.authors)} /></p>
  </div>
  <div class="brief-body">
    <h3><a href={href}>{b.headline}</a></h3>
    <p>{b.takeaway}</p>
    <div class="brief-foot">
      <ul class="tags" aria-label="Method and research areas">
        {b.method.map((m) => (
          <li><a class="tag method" href={`/briefs/?method=${encodeURIComponent(m)}`} data-method={m} title="See all briefs that used this method">{m}</a></li>
        ))}
        {shownAreas.map((a) => (
          <li><a class="tag ra" href={`/briefs/?area=${encodeURIComponent(a)}`} data-area={a} title={`See all briefs in ${a}`}>{a}</a></li>
        ))}
      </ul>
      <a class="read-more" href={href} aria-label={`Read more: ${b.headline}`}>Read more →</a>
    </div>
  </div>
</article>
