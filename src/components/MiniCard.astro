---
import { dateLabel, shortAuthors, type Brief } from "../lib/briefs";
interface Props { brief: Brief; }
const { brief } = Astro.props;
const b = brief.data;
---
<a class="mini" href={`/briefs/${brief.id}/`}>
  <div class="mini-top"><span class="brief-date">{dateLabel(b, "short")}</span><span class="tag method">{b.method[0]}</span></div>
  <h3>{b.headline}</h3>
  <p class="mini-meta"><span class="mini-auth" set:html={shortAuthors(b.authors)} /><i class="mini-journal">{b.journal}</i></p>
  <span class="mini-go">Read →</span>
</a>
