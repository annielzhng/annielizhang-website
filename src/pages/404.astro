---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="stack" style="--gap:20px">
    <p class="label">Page not found</p>
    <h1 class="page-title">This page has moved or doesn’t exist</h1>
    <p class="measure" style="font-size:1.15rem">If you followed an old link, the page may have a new address. Try the CSSC Briefs or the homepage.</p>
    <div class="btn-row"><a class="btn primary" href="/briefs/">CSSC Briefs</a><a class="btn" href="/">Homepage</a></div>
  </section>
</Base>
