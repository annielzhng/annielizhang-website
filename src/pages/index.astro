---
import Base from "../layouts/Base.astro";
import BriefCard from "../components/BriefCard.astro";
import Dendrimer from "../components/Dendrimer.astro";
import { getBriefs, dateLabel } from "../lib/briefs";
import site from "../data/site.json";
import areas from "../data/research-areas.json";

const all = await getBriefs();
const latest = all.slice(0, 3);
// The sample brief in "Why the CSSC Briefs": chosen in Site settings, or the latest if unset.
const sample = all.find((b) => b.id === (site as any).featuredBrief) ?? all[0];
---
<Base>
  <section class="hero">
    <div class="stack" style="--gap:22px">
      <p class="label">Assistant Professor · {site.department} · {site.affiliation}</p>
      <h1>{site.name}</h1>
      <p class="lede">I study how social media and new technologies shape the way the public understands science, and how scientists can communicate in ways that earn trust.</p>
      <div class="btn-row">
        <a class="btn primary" href="/briefs/">Read the CSSC Briefs</a>
        <a class="btn btn-cv btn-cv-pink" href={site.cv}>Curriculum vitae</a>
      </div>
    </div>
    <figure class="hero-figure">
      <Dendrimer />
      <figcaption>A dendrimer, the branching molecule I built as a chemistry student. <a href="/about/">How it led me to science communication</a></figcaption>
    </figure>
  </section>

  <section class="why2" aria-labelledby="why2-title">
    <div class="why-grid">
      <div class="why-copy">
        <div class="why2-head">
          <p class="label">Why the CSSC Briefs</p>
          <h2 id="why2-title">Being a science communication scholar means two things to me.</h2>
        </div>
        <p class="why-body">It’s about <span class="why-hl sage">exploring how media influences our understanding of and engagement with scientific issues</span>, and equally, <span class="why-hl pink">communicating my own science</span> with people and communities.</p>
        <p class="why-close">So I created the CSSC Briefs, short for <i class="why-name">Communicating the Science of Science Communication</i>: one for every project and publication.</p>
      </div>
      <div class="why-sample-wrap">
        <a class="why-sample" href={`/briefs/${sample.id}/`}>
          <span class="ws-meta">A CSSC Brief from {dateLabel(sample.data)}</span>
          <span class="ws-head">{sample.data.headline}</span>
          <span class="why-note" aria-hidden="true">the gist, in two sentences</span>
          <span class="ws-short">{sample.data.takeaway}</span>
          <span class="why-note" aria-hidden="true">then the full story: what we did, what we found, and why it matters</span>
          <span class="ws-read">Read this brief</span>
        </a>
        <span class="why-note why-note-end" aria-hidden="true">hopefully entertaining, too!</span>
      </div>
    </div>
  </section>

  <section class="block stack" style="--gap:0">
    <div class="section-head">
      <h2>Latest CSSC Briefs</h2>
      <a class="more" href="/briefs/">All briefs →</a>
    </div>
    <div class="brief-list">
      {latest.map((brief) => <BriefCard brief={brief} />)}
    </div>
  </section>

  <section class="block stack" style="--gap:28px">
    <div class="section-head">
      <h2>Research at a glance</h2>
      <a class="more" href="/research/">Research and publications →</a>
    </div>
    <div class="areas">
      {areas.map((a, k) => (
        <a class={`area t${k + 1}`} href={`/research/#${a.id}`}>
          <h3>{a.title}</h3>
          <p>{a.short}</p>
          <span class="go">Explore →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
